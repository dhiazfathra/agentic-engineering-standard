# Copy to apps/web/.env.local. Local defaults; no secrets live here.
DATABASE_URL=file:local.db
# Turso cloud only. Set in Vercel, never in a file.
DATABASE_AUTH_TOKEN=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rewind
S3_ACCESS_KEY=rewind
# Local-only MinIO password. Also read by docker-compose.yml.
S3_SECRET_KEY=rewind-local-secret
# Feature flags (SPEC-design-parity.md). "1" turns a flag on; anything else, or unset, is off.
NEXT_PUBLIC_FLAG_AI_SUMMARY=0
NEXT_PUBLIC_FLAG_SIMILAR_MERGE=0
NEXT_PUBLIC_FLAG_INTEGRATIONS=0
NEXT_PUBLIC_FLAG_BILLING=0
NEXT_PUBLIC_FLAG_SDK=0
NEXT_PUBLIC_FLAG_CLI_MCP=0
NEXT_PUBLIC_FLAG_WEBHOOKS=0
NEXT_PUBLIC_FLAG_HELPDESK=0
NEXT_PUBLIC_FLAG_SUPPORT_WIDGET=0
NEXT_PUBLIC_FLAG_EMAIL=0
NEXT_PUBLIC_FLAG_SSO_AUDIT_AUTODEL=0
NEXT_PUBLIC_FLAG_EXTERNAL_LINKS=0
